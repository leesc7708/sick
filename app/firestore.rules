rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isManager() { return isSignedIn() && myRole() in ['svisor', 'ssvisor']; }
    function isSsvisor() { return isSignedIn() && myRole() == 'ssvisor'; } // 모든 DB 열람

    // ── 계정 ──
    match /users/{uid} {
      // 본인 or 총괄(ssvisor)만 열람 — svisor의 전사 users 덤프 차단(읽기 범위 축소).
      // 관리자의 아이디 조회는 usernames 컬렉션(get)으로 대체.
      allow read: if isSignedIn() && (request.auth.uid == uid || isSsvisor());
      // 가입: 본인 문서, role=general·status=pending 로만 생성 가능
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'general'
        && request.resource.data.status == 'pending';
      // 수정: 본인은 role·status 못 바꿈 / ssvisor(총괄)는 전부 가능
      allow update: if isSignedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status)
        || isSsvisor()
      );
      allow delete: if isSsvisor();
    }

    // ── 그날의 현장 크루 (에스바이저 소유) ──
    match /crews/{cid} {
      allow create: if isManager() && request.resource.data.ownerUid == request.auth.uid;
      allow read:   if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isSsvisor());
      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid; // 종료·수정은 소유 svisor
      allow delete: if false;
    }

    // ── 크루 멤버십 (워커별 현재 소속) ──
    match /crewMemberships/{wuid} {
      // 본인 워커 or 자기 크루 소유 관리자 or 총괄 — 전사 멤버십 덤프 차단
      allow read: if isSignedIn() && (
        request.auth.uid == wuid
        || resource.data.ownerUid == request.auth.uid
        || isSsvisor());
      // 관리자(자기 크루로) 강제추가·이동·수정 / 워커 본인은 status='left'(자기 이탈)만
      allow write: if (isManager() && request.resource.data.ownerUid == request.auth.uid)
        || (request.auth.uid == wuid && request.resource.data.status == 'left');
    }

    // ── 아이디 조회 전용 (문서키=username, 최소 정보) ──
    match /usernames/{uname} {
      allow get:    if isManager();                                                  // 관리자 단건 조회(워커 추가)
      allow list:   if isSsvisor();                                                  // 목록 열거는 총괄만
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid; // 가입 시 본인 것만
      allow update: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow delete: if isSsvisor();
    }

    // ── 긴급 알림 (생성자에게만 라우팅) ──
    match /alerts/{id} {
      allow create: if isSignedIn() && request.resource.data.workerUid == request.auth.uid;
      allow read:   if isSignedIn() && (resource.data.workerUid == request.auth.uid
                      || resource.data.notifyUid == request.auth.uid || isSsvisor());
      allow update: if isSignedIn() && (resource.data.notifyUid == request.auth.uid || isSsvisor());
      allow delete: if false;
    }
  }
}
