rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isManager() { return isSignedIn() && myRole() in ['svisor', 'ssvisor']; }
    function isSsvisor() { return isSignedIn() && myRole() == 'ssvisor'; } // 모든 DB 열람

    // ── 계정 ──
    match /users/{uid} {
      // 본인 or 관리자(svisor/ssvisor) 열람
      allow read: if isSignedIn() && (request.auth.uid == uid || isManager());
      // 가입: 본인 문서, role=general·status=pending 로만 생성 가능
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'general'
        && request.resource.data.status == 'pending';
      // 수정: 본인은 role·status 못 바꿈 / ssvisor(총괄)는 전부 가능
      allow update: if isSignedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status)
        || isSsvisor()
      );
      allow delete: if isSsvisor();
    }

    // ── 긴급 알림 ──
    match /alerts/{id} {
      // 근로자는 자기 alert 생성
      allow create: if isSignedIn() && request.resource.data.workerUid == request.auth.uid;
      // 본인(자기 alert) 또는 관리자 열람
      allow read: if isSignedIn() && (resource.data.workerUid == request.auth.uid || isManager());
      // 상태변경(확인 등)은 관리자만. 삭제 금지(기록 보존)
      allow update: if isManager();
      allow delete: if false;
    }
  }
}
